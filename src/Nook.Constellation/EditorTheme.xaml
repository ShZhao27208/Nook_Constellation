<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#1F4A43"/><Setter Property="Background" Value="#F4F1EA"/><Setter Property="BorderBrush" Value="#CBCFC5"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B38A46"/><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A73A2A"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#46504D"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#17211F"/><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#CBCFC5"/><Setter Property="Padding" Value="5"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="DatePicker"><Setter Property="Foreground" Value="#17211F"/><Setter Property="Background" Value="#FFFDF8"/><Setter Property="BorderBrush" Value="#CBCFC5"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#1F4A43"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#46504D"/><Setter Property="Margin" Value="0,6,0,4"/></Style>
</ResourceDictionary>
