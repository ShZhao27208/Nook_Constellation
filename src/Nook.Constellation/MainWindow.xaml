<Window x:Class="Nook.Constellation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="隅星集 · Nook Constellation" Width="380" Height="280" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Foreground="White">
<Border BorderBrush="#FFCAD7EF" BorderThickness="1" CornerRadius="14" Padding="12" Background="Transparent">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ExpandButton" Content="⛶" ToolTip="放大 / 还原" AutomationProperties.Name="放大或还原" Click="ExpandClick"/><Button Content="×" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘" Click="HideClick"/></StackPanel>
<TextBlock Text="隅星集" FontSize="18" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="1"/></TextBlock.Effect></TextBlock>
</DockPanel>
<Grid Grid.Row="1" Margin="4,12">
<Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="#668EA2BF" BorderThickness="0,0,0,0"/>
<Rectangle Grid.ColumnSpan="2" Height="1" Fill="#CCCAD7EF" VerticalAlignment="Bottom"/>
<Rectangle Grid.RowSpan="2" Width="1" Fill="#CCCAD7EF" HorizontalAlignment="Right"/>
<TextBlock Text="重要不紧急" FontSize="11" Margin="5" Opacity="0.8"/><TextBlock Grid.Column="1" Text="重要且紧急" FontSize="11" Margin="5" Opacity="0.8"/>
<TextBlock Grid.Row="1" Text="不重要也不紧急" FontSize="11" Margin="5" VerticalAlignment="Bottom" Opacity="0.8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="不重要但紧急" FontSize="11" Margin="5" VerticalAlignment="Bottom" Opacity="0.8"/>
</Grid>
<DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="＋" IsEnabled="False" ToolTip="任务录入将在任务管理阶段启用" AutomationProperties.Name="新增任务"/><Button DockPanel.Dock="Left" Content="⚙" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClick"/><TextBlock Text="桌面窗口预览" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"/></DockPanel>
</Grid></Border></Window>
