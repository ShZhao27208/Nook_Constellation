<Window x:Class="Nook.Constellation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="app.ico" Title="隅星集 · Nook Constellation" Width="380" Height="280" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Foreground="White">
<Border BorderBrush="#FFCAD7EF" BorderThickness="1" CornerRadius="14" Padding="10" Background="Transparent">
<Grid x:Name="RootGrid">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ExpandButton" Content="⛶" ToolTip="放大 / 还原" AutomationProperties.Name="放大或还原" Click="ExpandClick"/><Button Content="×" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘" Click="HideClick"/></StackPanel>
<TextBlock Text="隅星集" FontSize="18" VerticalAlignment="Center"/>
</DockPanel>
<Grid Grid.Row="1" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="70"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
<TextBox x:Name="SearchBox" ToolTip="搜索标题、备注、标签" AutomationProperties.Name="搜索任务" Padding="3" Background="#99202A3B" Foreground="White" BorderBrush="#667B8BA4"/>
<TextBox x:Name="TagsBox" Grid.Column="1" ToolTip="标签筛选：多个标签用逗号分隔，任一匹配" AutomationProperties.Name="标签筛选" Padding="3" Margin="3,0" Background="#99202A3B" Foreground="White" BorderBrush="#667B8BA4"/>
<TextBlock Text="搜索任务" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0" FontSize="11" Foreground="#FFB7C7DF"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Grid.Column="1" Text="标签" IsHitTestVisible="False" VerticalAlignment="Center" Margin="7,0" FontSize="11" Foreground="#FFB7C7DF"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TagsBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<ComboBox x:Name="ScopeBox" Grid.Column="2" SelectedIndex="0" ToolTip="今天包含此前未完成任务"><ComboBoxItem Content="今天"/><ComboBoxItem Content="全部"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="回收站"/></ComboBox>
<Button Grid.Column="3" Content="×" Padding="0" Margin="2,0,0,0" ToolTip="清除搜索与标签筛选" Click="ClearFilter"/>
</Grid>
<Grid x:Name="ViewGrid" Grid.Row="2" Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition x:Name="MatrixColumn" Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
<Canvas x:Name="MatrixCanvas" ClipToBounds="True" Background="Transparent"/>
<ScrollViewer x:Name="FlowScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskList"/></ScrollViewer>
</Grid>
<DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="＋" ToolTip="新任务" AutomationProperties.Name="新增任务" Click="AddClick"/><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="⚙" ToolTip="设置与数据" AutomationProperties.Name="设置" Click="SettingsClick"/><Button x:Name="ViewButton" Content="≡" ToolTip="切换四象限 / 任务流" Click="ViewClick"/></StackPanel><Button x:Name="UndoButton" Visibility="Collapsed" Content="撤销删除" Click="UndoClick"/><TextBlock x:Name="StatusText" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFE0E9F9"/></DockPanel>
<Canvas x:Name="Particles" Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True"/>
</Grid></Border></Window>
